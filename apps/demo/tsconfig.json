{
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.mts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@wasm-runtime/browser": ["../../packages/browser/src/index.ts"],
      "@wasm-runtime/ir": ["../../packages/ir/src/index.ts"],
      "@wasm-runtime/tanstack-adapter": ["../../packages/tanstack-adapter/src/index.ts"],
      "@wasm-runtime/vite-plugin": ["../../packages/vite-plugin/src/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
