{
  "name": "@wasm-runtime/demo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "yarn workspace @wasm-runtime/compiler build && yarn workspace @wasm-runtime/browser build && yarn workspace @wasm-runtime/tanstack-adapter build && yarn workspace @wasm-runtime/vite-plugin build && vite build",
    "preview": "vite preview",
    "test": "set VITEST=1&& vitest run --passWithNoTests",
    "bench": "node scripts/bench.mjs",
    "lint": "echo lint not configured for @wasm-runtime/demo",
    "typecheck": "tsc --noEmit",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/db": "latest",
    "@tanstack/query-core": "latest",
    "@tanstack/query-db-collection": "latest",
    "@tanstack/react-db": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-core": "latest",
    "@wasm-runtime/browser": "workspace:*",
    "@wasm-runtime/ir": "workspace:*",
    "@wasm-runtime/tanstack-adapter": "workspace:*",
    "@wasm-runtime/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@wasm-runtime/vite-plugin": "workspace:*",
    "playwright": "^1.55.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
