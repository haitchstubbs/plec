{
  "name": "@wasm-runtime/fullstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn dev:rebuild",
    "start": "node dist/server.mjs",
    "start:rust": "cargo run --quiet -p plec-cli -- serve dist",
    "build:plec": "plec build src/app.tsx --out-dir dist",
    "build:css": "tailwindcss -i src/styles.css -o dist/public/assets/styles.css",
    "dev:rebuild": "yarn check:no-react && yarn --cwd ../.. exec turbo run build --filter=@wasm-runtime/fullstack && node --watch dist/server.mjs",
    "build": "yarn check:no-react && yarn build:plec && node scripts/build.mjs && yarn build:css",
    "test": "yarn check:no-react && vitest run",
    "typecheck": "yarn check:no-react && cargo check -p plec-compiler",
    "check:no-react": "node scripts/check-no-react.mjs",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "@wasm-runtime/lucide-plec": "workspace:*",
    "@wasm-runtime/ui": "workspace:*",
    "plec": "workspace:*",
    "plec-browser": "workspace:*",
    "plec-server": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
