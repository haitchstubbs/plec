{
  "name": "fullstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plec dev",
    "start": "plec serve dist",
    "copy:licenses": "mkdir -p dist/public/licenses && cp ../../node_modules/lucide/LICENSE dist/public/licenses/Lucide-LICENSE.txt && cp ../../node_modules/@fontsource-variable/outfit/LICENSE dist/public/licenses/Outfit-OFL-1.1.txt && cp ../../node_modules/@fontsource-variable/raleway/LICENSE dist/public/licenses/Raleway-OFL-1.1.txt",
    "build": "yarn check:no-react && plec build && yarn copy:licenses",
    "test": "yarn check:no-react && vitest run",
    "typecheck": "yarn --cwd ../.. rust:deps:check && yarn typecheck:ci",
    "typecheck:ci": "yarn check:no-react && cargo check --locked -p plec-compiler",
    "check:no-react": "node scripts/check-no-react.mjs",
    "clean": "rm -rf dist",
    "clean:windows": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@plec/core": "workspace:*",
    "@plec/lucide": "workspace:*",
    "lucide": "^1.31.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
