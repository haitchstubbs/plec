{
  "name": "@wasm-runtime/fullstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn dev:rebuild",
    "start": "cargo run --quiet -p plec-cli -- serve dist",
    "prep:assetdir": "mkdir -p dist/public/assets/files",
    "copy:fonts:outfit": "yarn prep:assetdir && cp ../../node_modules/@fontsource-variable/outfit/files/*.woff2 dist/public/assets/files/",
    "copy:fonts:raleway": "yarn prep:assetdir && cp ../../node_modules/@fontsource-variable/raleway/files/*.woff2 dist/public/assets/files/",
    "copy:fonts": "yarn copy:fonts:outfit && yarn copy:fonts:raleway",
    "build:plec": "plec build src/app.tsx --out-dir dist",
    "build:css": "tailwindcss -i src/styles.css -o dist/public/assets/styles.css",
    "dev:rebuild": "yarn check:no-react && yarn --cwd ../.. exec turbo run build --filter=@wasm-runtime/fullstack && yarn start",
    "build": "yarn check:no-react && yarn build:plec && yarn copy:fonts && yarn build:css",
    "test": "yarn check:no-react && vitest run",
    "typecheck": "yarn check:no-react && cargo check -p plec-compiler",
    "check:no-react": "node scripts/check-no-react.mjs",
    "clean": "rm -rf dist",
    "clean:windows": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@wasm-runtime/lucide-plec": "workspace:*",
    "@wasm-runtime/ui": "workspace:*",
    "lucide": "^1.31.0",
    "plec": "workspace:*",
    "plec-browser": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
