{
  "name": "@wasm-runtime/browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn --cwd ../.. exec tsc -p packages/browser/tsconfig.json",
    "test": "yarn exec vitest run --passWithNoTests",
    "lint": "echo lint not configured for @wasm-runtime/browser",
    "typecheck": "yarn exec tsc -p tsconfig.json --noEmit",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "comlink": "^4.4.2"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
