{
  "name": "@plec/lucide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "default": "./src/Icon.tsx"
    }
  },
  "files": [
    "dist"
  ],
  "description": "Unofficial experimental PLEC integration for Lucide icons; not affiliated with or supported by Lucide.",
  "keywords": [
    "plec",
    "lucide",
    "icons",
    "experimental"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p ./tsconfig.json",
    "test": "yarn exec vitest run --passWithNoTests",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@plec/core": "workspace:*",
    "lucide": "^1.31.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}
