{
  "name": "@wasm-runtime/vite-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn --cwd ../.. exec tsc -p packages/vite-plugin/tsconfig.build.json",
    "test": "yarn exec vitest run --passWithNoTests",
    "lint": "echo lint not configured for @wasm-runtime/vite-plugin",
    "typecheck": "yarn exec tsc -p tsconfig.json --noEmit --rootDir ../..",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "@swc/core": "^1.13.5",
    "@wasm-runtime/compiler": "workspace:*",
    "magic-string": "^0.30.17",
    "vite": "^7.1.4"
  }
}
