{
  "name": "plec-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cargo check --manifest-path crates/runtime/Cargo.toml && yarn build:wasm",
    "build:wasm": "cd ../.. && node scripts/build-wasm.mjs packages/plec-runtime/crates/runtime packages/plec-runtime/dist/runtime",
    "dev:wasm": "node scripts/watch-wasm.mjs",
    "test": "cargo test --manifest-path crates/runtime/Cargo.toml --lib",
    "test:core": "cargo test --manifest-path crates/runtime/Cargo.toml --no-default-features",
    "test:wasm": "node scripts/browser-harness.mjs",
    "lint": "echo lint not configured for plec-runtime",
    "typecheck": "echo typecheck not applicable for Rust package",
    "clean": "cargo clean --manifest-path crates/runtime/Cargo.toml"
  }
}
