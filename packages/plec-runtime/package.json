{
  "name": "plec-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/verify-toolchain.mjs && cargo check --locked --manifest-path ../../crates/plec-runtime/Cargo.toml && yarn build:wasm",
    "build:wasm": "cd ../.. && node scripts/verify-toolchain.mjs && node scripts/build-wasm.mjs crates/plec-runtime packages/plec-runtime/dist/runtime",
    "dev:wasm": "cd ../.. && node scripts/watch-wasm.mjs",
    "test": "node ../../scripts/verify-toolchain.mjs && cargo test --locked --manifest-path ../../crates/plec-runtime/Cargo.toml --lib",
    "test:core": "node ../../scripts/verify-toolchain.mjs && cargo test --locked --manifest-path ../../crates/plec-runtime/Cargo.toml --no-default-features",
    "test:wasm": "cd ../../ && node scripts/browser-harness.mjs",
    "lint": "echo lint not configured for plec-runtime",
    "typecheck": "echo typecheck not applicable for Rust package",
    "clean": "cargo clean --manifest-path ../../crates/plec-runtime/Cargo.toml"
  }
}
