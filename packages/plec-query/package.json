{
  "name": "plec-query",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "import": "./dist/zod/index.js"
    }
  },
  "files": [
    "dist",
    "native"
  ],
  "imports": {
    "#core": "./dist/core/index.js",
    "#main": "./dist/main/index.js",
    "#schemas": "./dist/schemas/index.js",
    "#types": "./dist/types/index.js",
    "#core/*": "./dist/core/*",
    "#main/*": "./dist/main/*",
    "#schemas/*": "./dist/schemas/*",
    "#types/*": "./dist/types/*"
  },
  "scripts": {
    "build": "tsc",
    "compile": "yarn compile:native && yarn compile:wasm",
    "compile:native": "napi build --platform --release --no-js --manifest-path ../../crates/plec-query-node/Cargo.toml --output-dir native",
    "compile:wasm": "cargo build --manifest-path ../../crates/plec-query-core/Cargo.toml --target wasm32-unknown-unknown --release",
    "docs:generate-dialect-matrix": "node ./scripts/generate-dialect-matrix.mjs",
    "docs:check-dialect-matrix": "node ./scripts/generate-dialect-matrix.mjs --check",
    "bench:query-parity:baseline": "node ./scripts/run-query-parity-benchmark.mjs baseline",
    "bench:query-parity:post": "node ./scripts/run-query-parity-benchmark.mjs post",
    "bench:query-parity:report": "node ./scripts/run-query-parity-benchmark-report.mjs",
    "bench:query-parity": "yarn bench:query-parity:baseline && yarn bench:query-parity:post && yarn bench:query-parity:report",
    "bench:query-cache-hit:baseline": "node ./scripts/run-query-cache-hit-benchmark.mjs baseline",
    "bench:query-cache-hit:post": "node ./scripts/run-query-cache-hit-benchmark.mjs post",
    "bench:query-cache-hit:report": "node ./scripts/run-query-cache-hit-benchmark-report.mjs",
    "bench:query-cache-hit": "yarn bench:query-cache-hit:baseline && yarn bench:query-cache-hit:post && yarn bench:query-cache-hit:report",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts && yarn test:types",
    "test:runtime": "vitest run --config vitest.config.ts",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.0",
    "@types/node": "^24.4.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "kysely": "^0.29.2",
    "plec-eslint-config": "*",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "type-fest": "^5.7.0",
    "zod": "^4.4.3"
  }
}
