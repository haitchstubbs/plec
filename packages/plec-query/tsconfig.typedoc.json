{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "#core": ["./src/core/index.ts"],
      "#main": ["./src/main/index.ts"],
      "#types": ["./src/types/index.ts"],
      "#schemas": ["./src/schemas/index.ts"],
      "#core/*": ["./src/core/*"],
      "#main/*": ["./src/main/*"],
      "#types/*": ["./src/types/*"],
      "#schemas/*": ["./src/schemas/*"]
    }
  }
}
