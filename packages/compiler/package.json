{
  "name": "@wasm-runtime/compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn --cwd ../.. exec tsc -p packages/compiler/tsconfig.json",
    "test": "vitest run",
    "lint": "echo lint not configured for @wasm-runtime/compiler",
    "typecheck": "yarn exec tsc -p tsconfig.json --noEmit",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "@swc/core": "^1.13.5",
    "@wasm-runtime/ir": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
