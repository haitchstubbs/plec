{
  "name": "plec-e2e",
  "packageManager": "yarn@4.17.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "test:bench": "playwright test --config playwright.bench.config.ts --grep-invert @smoke",
    "test:bench:smoke": "playwright test --config playwright.bench.config.ts --grep @smoke",
    "typecheck": "yarn --cwd ../.. exec tsc -p packages/plec-e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^3.2.4"
  }
}
