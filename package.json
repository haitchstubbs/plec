{
  "name": "plec-js",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "22.20.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:build-tools": "node scripts/setup.mjs --profile build",
    "install:browser-tools": "node scripts/setup.mjs --profile browser",
    "install:rust-security-tools": "node scripts/setup.mjs --profile rust-security",
    "install:cargo-deny": "node scripts/setup.mjs --profile cargo-deny",
    "install:security-tools": "node scripts/setup.mjs --profile security",
    "install:plec-cli": "yarn rust:deps:check && cargo install --locked --path crates/plec-cli",
    "install:plec-cli:dev": "yarn rust:deps:check && PLEC_CLI_VERSION=dev cargo install --locked --path crates/plec-cli --force",
    "setup": "yarn install --immutable && yarn install:build-tools && yarn build --force",
    "toolchain:verify": "node scripts/verify-toolchain.mjs",
    "toolchain:verify:browser": "node scripts/verify-toolchain.mjs --profile build,browser,runtime",
    "rust:deps:check": "node scripts/check-rust-deps.mjs",
    "rust:deps:audit": "node scripts/check-rust-deps.mjs --full",
    "rust:deps:list": "cargo tree --locked --prefix none",
    "rust:deps:tree": "cargo tree --locked",
    "dev": "turbo run dev --parallel",
    "dev:wasm": "yarn workspace @plec/core dev:wasm",
    "build": "yarn rust:deps:check && turbo run build",
    "check:licenses": "node scripts/check-rust-deps.mjs --licenses",
    "test": "turbo run test",
    "test:acceptance": "turbo run test:acceptance",
    "test:e2e": "turbo run test:e2e",
    "test:runtime": "yarn workspace @plec/core test:runtime",
    "test:wasm": "node packages/plec/bin/plec.js workspace test wasm",
    "test:wasm:query": "node packages/plec/bin/plec.js workspace test last",
    "bench": "turbo run bench",
    "lint": "yarn format:check",
    "format": "prettier --write . && cargo fmt --manifest-path crates/plec-runtime/Cargo.toml",
    "format:check": "node scripts/check-json-duplicates.mjs turbo.json && prettier --check . && cargo fmt --manifest-path crates/plec-runtime/Cargo.toml --check",
    "check:sast": ".tools/opengrep-1.30.0/opengrep scan --config p/security-audit --sarif --sarif-output opengrep-results.sarif --error --include '*.rs' --include '*.ts' --include '*.tsx' --include '*.js' --include '*.jsx' --include '*.css' .",
    "typecheck": "turbo run typecheck",
    "inspect:fixture": "node scripts/inspect-fixture.mjs",
    "measure:runtime-baseline": "node benchmarks/measure-runtime-baseline.mjs",
    "measure:runtime-baseline:verify": "node benchmarks/measure-runtime-baseline.mjs --verify",
    "clean": "turbo run clean && git clean -xdf .turbo",
    "issue": "node scripts/get-gh-issue.mjs"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.2",
    "@types/node": "^24.4.0",
    "binaryen": "^131.0.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-toml": "^2.0.6",
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
