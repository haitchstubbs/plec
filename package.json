{
  "name": "wasm-runtime",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "yarn turbo prune && yarn install && yarn build --force",
    "dev": "turbo run dev --parallel",
    "dev:wasm": "yarn workspace plec-runtime dev:wasm",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "yarn format:check",
    "format": "prettier --write . && cargo fmt --manifest-path packages/plec-runtime/crates/runtime/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path packages/plec-runtime/crates/runtime/Cargo.toml --check",
    "typecheck": "turbo run typecheck",
    "measure:runtime-baseline": "node benchmarks/measure-runtime-baseline.mjs",
    "measure:runtime-baseline:verify": "node benchmarks/measure-runtime-baseline.mjs --verify",
    "clean": "turbo run clean && git clean -xdf .turbo"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "binaryen": "^131.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
