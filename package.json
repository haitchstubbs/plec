{
  "name": "wasm-runtime",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:build-tools": "node scripts/setup.mjs",
    "roadmap": "dotenv -e .env.devports -- sh -c 'bdui start --port \"$BEADS_UI_PORT\"'",
    "roadmap:stop": "yarn bdui stop",
    "setup": "yarn install:build-tools && yarn install && yarn build --force",
    "dev": "turbo run dev --parallel",
    "dev:wasm": "yarn workspace plec-runtime dev:wasm",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:runtime": "yarn workspace plec-runtime test",
    "test:wasm": "yarn workspace plec-runtime test:wasm",
    "test:adoption": "turbo run test:acceptance --filter=@wasm-runtime/fullstack",
    "lint": "yarn format:check",
    "format": "prettier --write . && cargo fmt --manifest-path packages/plec-runtime/crates/runtime/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path packages/plec-runtime/crates/runtime/Cargo.toml --check",
    "typecheck": "turbo run typecheck",
    "inspect:fixture": "node scripts/inspect-fixture.mjs",
    "env:browser": "node scripts/browser-info.mjs",
    "measure:runtime-baseline": "node benchmarks/measure-runtime-baseline.mjs",
    "measure:runtime-baseline:verify": "node benchmarks/measure-runtime-baseline.mjs --verify",
    "clean": "turbo run clean && git clean -xdf .turbo && yarn roadmap:stop"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "beads-ui": "^0.12.6",
    "binaryen": "^131.0.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
