{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "@plec/core#build": {
      "dependsOn": ["@plec/browser#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../Cargo.lock",
        "../../Cargo.toml",
        "../../crates/**"
      ],
      "outputs": ["dist/**"]
    },
    "@plec/node#build": {
      "cache": false,
      "outputs": [
        "dist/**",
        "native/index.js",
        "native/index.d.ts",
        "native/bindings.d.ts",
        "native/*.node"
      ]
    },
    "fullstack#build": {
      "cache": false,
      "dependsOn": ["@plec/core#build"],
      "env": ["PLEC_BIN"],
      "outputs": ["dist/**"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:package": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["fullstack#build"],
      "env": ["E2E_PORT", "PLEC_BIN", "PLEC_E2E_HOST", "PLEC_E2E_DIST"],
      "outputs": []
    },
    "test:acceptance": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["fullstack#build"],
      "env": ["E2E_PORT", "PLEC_E2E_HOST", "PLEC_E2E_DIST", "PLEC_BIN"],
      "outputs": []
    },
    "bench": {
      "cache": false,
      "dependsOn": ["fullstack#build"],
      "env": [
        "E2E_PORT",
        "PLEC_BENCH_SAMPLES",
        "PLEC_BENCHMARK_ORIGIN"
      ],
      "outputs": ["benchmarks/results/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@plec/core#typecheck": {
      "dependsOn": ["^typecheck", "@plec/browser#build"],
      "outputs": []
    },
    "@plec/core#build:types": {
      "dependsOn": ["^typecheck", "@plec/browser#build"],
      "outputs": ["dist/**"]
    },
    "@plec/lucide#typecheck": {
      "dependsOn": ["@plec/core#build:types"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
