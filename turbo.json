{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "plec#build": {
      "dependsOn": ["plec-browser#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../Cargo.lock",
        "../../Cargo.toml",
        "../../crates/**"
      ],
      "outputs": ["dist/**"]
    },
    "fullstack#build": {
      "cache": false,
      "dependsOn": ["plec#build"],
      "env": ["PLEC_BIN"],
      "outputs": ["dist/**"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["fullstack#build"],
      "env": ["E2E_PORT", "PLEC_BIN"],
      "outputs": []
    },
    "test:acceptance": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["fullstack#build"],
      "env": ["E2E_PORT"],
      "outputs": []
    },
    "bench": {
      "cache": false,
      "dependsOn": ["fullstack#build"],
      "env": [
        "E2E_PORT",
        "PLEC_BENCH_SAMPLES",
        "PLEC_BENCHMARK_ORIGIN"
      ],
      "outputs": ["benchmarks/results/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "plec#typecheck": {
      "dependsOn": ["^typecheck", "plec-browser#build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
