{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "plec-runtime#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@wasm-runtime/fullstack#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["build"],
      "outputs": ["benchmarks/results/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
